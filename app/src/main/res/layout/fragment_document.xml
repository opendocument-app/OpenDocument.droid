<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- one tab per sheet for spreadsheets, hidden for every other format -->
        <com.google.android.material.tabs.TabLayout
                android:id="@+id/document_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:tabMode="scrollable" />

        <FrameLayout
                android:id="@+id/page_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
    </LinearLayout>

    <!--
         over the document rather than beside it. nothing in here is clickable while the actions
         are folded up, so every touch that misses a button reaches the page below.
    -->
    <app.opendocument.droid.ui.widget.DocumentActions
            android:id="@+id/document_actions"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
</FrameLayout>
