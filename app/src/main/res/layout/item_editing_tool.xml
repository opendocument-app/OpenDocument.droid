<?xml version="1.0" encoding="utf-8"?>
<!-- one tool of EditingTools: its icon, and under it a bar in the colour it applies, if any -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_editing_tool"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

    <ImageView
            android:id="@+id/editing_tool_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurface" />

    <View
            android:id="@+id/editing_tool_bar"
            android:layout_width="18dp"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_color_bar"
            android:visibility="gone" />
</LinearLayout>
