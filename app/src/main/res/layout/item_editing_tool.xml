<?xml version="1.0" encoding="utf-8"?>
<!--
     one tool of EditingTools, a square so that a row of them reads as a row. The slot under the
     icon is the same height on every tool, whether it holds anything or not, so that the icons of
     a row sit on one line.

     The slot is deep, and the bar sits at the foot of it: an icon's ink ends where its own shape
     says - a squiggle dips, a strikethrough stops high - and with the bar close under it that
     difference reads as bars at different heights. Away from the ink, the eye lines them up
     against each other instead.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_editing_tool"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

    <ImageView
            android:id="@+id/editing_tool_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurface" />

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="17dp">

        <!-- the colour the tool applies, which is what a tap uses -->
        <View
                android:id="@+id/editing_tool_bar"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="1dp"
                android:background="@drawable/bg_color_bar"
                android:visibility="gone" />

        <!-- what the tool reads on the selection: the size the text is in -->
        <TextView
                android:id="@+id/editing_tool_caption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
