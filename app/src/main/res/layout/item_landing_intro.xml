<?xml version="1.0" encoding="utf-8"?>

<!-- What the app is for, three lines of it, the same copy the welcome screen used to carry.

     A section of the list like any other, above the settings rather than below them: a reader
     saying what it reads is worth more of the screen than a switch that matters to a handful of
     users. It folds away once there are documents to read instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/landing_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="20dp"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/landing_intro_view"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_folder_open" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="20dp"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/landing_intro_search"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_search" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="20dp"
            android:gravity="center_vertical"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/landing_intro_edit"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_edit" />
</LinearLayout>
