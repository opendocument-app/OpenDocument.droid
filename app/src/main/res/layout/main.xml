<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start|top"
        android:orientation="vertical">

    <!--
         the edit mode's tools, driven by DocumentFragment. here rather than in the fragment so
         they sit right under the edit mode's bar, above the banner
    -->
    <app.opendocument.droid.ui.widget.EditingTools
            android:id="@+id/editing_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="?attr/colorSurfaceContainer"
            android:visibility="gone" />

    <!--
         owned by AdManager, which casts it to a LinearLayout and drives its visibility
         itself. the landing and the document sit below it, so the banner pushes them down
         rather than covering them.
    -->
    <LinearLayout
            android:id="@+id/ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/editing_tools"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone" />

    <!-- holds LandingFragment, added once in MainActivity.onCreate -->
    <FrameLayout
            android:id="@+id/landing_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ad_container" />

    <FrameLayout
            android:id="@+id/document_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ad_container"
            android:background="@color/document_background"
            android:visibility="gone" />
</RelativeLayout>
