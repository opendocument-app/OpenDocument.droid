<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Edge-to-edge is enforced from targetSdk 35 on; the system bars are transparent over the
        app's own UI, so the icon colour has to follow whichever theme is in effect. Insets are
        handled in MainActivity.
    -->
    <style name="MainTheme" parent="Base.MainTheme">
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_system_bars</item>
    </style>

</resources>
